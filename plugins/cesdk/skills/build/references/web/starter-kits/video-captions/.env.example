# CE.SDK License Key
# Request a license at https://img.ly/forms/contact-sales/
VITE_CESDK_LICENSE=YOUR_LICENSE_KEY_HERE

# Optional: where this kit's demo assets (scenes, images, fonts) are loaded
# from. Leave it unset to load them from the IMG.LY CDN.
# Full copy of the demo assets: https://staticimgly.com/imgly/cesdk-web-examples-data/1.84.0-rc.1/starterkit-video-captions/demo-assets.zip
VITE_DEMO_ASSETS_BASE_URL=https://staticimgly.com/imgly/cesdk-web-examples-data/1.84.0-rc.1/starterkit-video-captions

# Optional: proxy for the fal.ai transcription used by AI Auto Captions.
# Keeps your fal.ai API key off the client. Defaults to IMG.LY's demo proxy,
# which is rate limited and not for production use.
# VITE_AUTOCAPTION_PROXY_URL=https://your-proxy.example.com/api/proxy/falai
