{
  "name": "starterkit-multi-image-generation",
  "version": "1.0.0",
  "description": "CE.SDK Multi-Image Generation Starterkit - Generate multiple branded images from restaurant data",
  "private": true,
  "scripts": {
    "secrets": "bash scripts/setup-secrets.sh",
    "dev": "cesdk-js-dev vite",
    "prebuild": "npm run check:all",
    "build": "vite build",
    "preview": "vite preview",
    "check:syntax": "tsc --project tsconfig.json --noEmit",
    "check:format": "prettier --check \"**/*.{ts,js,json,html}\"",
    "check:lint": "eslint --max-warnings 0 \"**/*.{ts,tsx,js}\"",
    "check:all": "npm run check:syntax && npm run check:format && npm run check:lint",
    "fix:format": "prettier --write \"**/*.{ts,js,json,html}\"",
    "fix:lint": "eslint --fix \"**/*.{ts,tsx,js}\"",
    "fix:all": "npm run fix:format && npm run fix:lint",
    "test:unit": "vitest run -c tests/vitest.config.ts",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:e2e && node ../kit-test-harness/scripts/merge-coverage.mjs .",
    "ci": "npm run check:all && npm run test:all",
    "capture:hero_image": "node scripts/capture-hero.mjs"
  },
  "dependencies": {
    "@cesdk/cesdk-js": "workspace:*",
    "@cesdk/engine": "workspace:*",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@imgly/kit-test-harness": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.50.0",
    "eslint-plugin-jsdoc": "^46.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.55.1",
    "prettier": "^3.0.0",
    "sharp": "^0.35.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "nx": {
    "targets": {
      "check:lint": {
        "dependsOn": [
          "^build:api"
        ],
        "inputs": [
          "default",
          {
            "dependentTasksOutputFiles": "**/*.d.ts"
          }
        ]
      },
      "test:unit": {
        "cache": false,
        "dependsOn": [
          "^build:production",
          "^build",
          "^build:assets"
        ]
      },
      "test:e2e": {
        "cache": false,
        "dependsOn": [
          "^build:production",
          "^build",
          "^build:assets"
        ]
      },
      "ci": {
        "cache": false,
        "dependsOn": [
          "^build:production",
          "^build",
          "^build:assets"
        ]
      }
    }
  }
}
